# Chép file này thành .env rồi điền. KHÔNG commit file .env.
# Lấy ở Supabase → Settings → API

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role — đi vòng qua mọi RLS
                                       # chỉ nằm trên máy này, không bao giờ lên repo
SUPABASE_ANON_KEY=eyJ...               # anon — tao-cau-hinh.mjs sinh site/cau-hinh.js
                                       # cho app điện thoại. RLS chặn người không phải chủ.

# Thư mục agent được phép đọc ghi
DIR_ELEARNING=/Users/chihien/Documents/Công việc/Elearning
DIR_LAB=/Users/chihien/Documents/Công việc/agent-app/lab-repo
DIR_BIZ=/Users/chihien/Documents/Công việc/fitness-website
