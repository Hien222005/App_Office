<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hẹn giờ chạy agent tự động. Chỉ cài khi nếp làm việc đã ổn định (tuần 3 trở đi).
  Cài:   cp agent/com.chihien.agent.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.chihien.agent.plist
  Gỡ:    launchctl unload ~/Library/LaunchAgents/com.chihien.agent.plist

  Mac tự thức dậy (cắm điện, đóng nắp vẫn chạy):
         sudo pmset repeat wakeorpoweron MTWRFSU 06:25:00

  launchd KHÔNG đọc ~/.zshrc nên phải dùng /bin/zsh -lc để nạp PATH.

  Chỉ hẹn giờ lệnh `sang` (chỉ đọc, không sửa file). Hai lệnh `lam` và `chot`
  phải gõ tay, vì chúng cần sếp chốt việc và duyệt kết quả ở giữa.
  Nhật ký chạy: /tmp/agent-sang.log
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.chihien.agent.sang</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd ~/Documents/Công\ việc/agent-app &amp;&amp; caffeinate -i claude -p "/task sang" &gt;&gt; /tmp/agent-sang.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
</dict></plist>
